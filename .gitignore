node_modules/
out/
dist/

# TypeScript composite-build emit (electron/main, src/**) and tsbuildinfo.
# Real build goes through electron-vite; tsc --build is only used for
# noEmit type-checking but accidentally emits unless --noEmit is passed.
*.tsbuildinfo
electron/**/*.js
electron/**/*.d.ts
electron.vite.config.js
electron.vite.config.d.ts
src/**/*.d.ts
src/**/*.js
# Allow legitimate hand-written declarations / scripts / config
!src/shared/types/electron.d.ts
!src/vite-env.d.ts

# Generated at build time by scripts/download-python-embed.js
resources/python-embed/
resources/get-pip.py

# Python
api/__pycache__/
api/**/__pycache__/
api/*.pyc
api/**/*.pyc
api/.venv/
api/venv/
tools/modly-cli/__pycache__/
.hermes-e2e/

# Models (heavy, downloaded at runtime)
/models/

# Local runtime data (models / workspace / extensions / workflows / dependencies)
# Created and populated by run-local.sh and the app at runtime.
/datas/
/output/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/

# Env
.env
.env.local

# TypeScript incremental build output
*.tsbuildinfo

# Local dev helpers
install.bat
launch.bat
