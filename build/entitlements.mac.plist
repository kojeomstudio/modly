<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        PyTorch and embedded Python both generate and execute code at
        runtime (Metal kernels for MPS, ahead-of-time C extension JIT,
        FX/torch.compile fragments). Hardened Runtime blocks that by
        default; these three keys are the minimum needed for inference
        to run inside a notarized .app.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
        The embedded python-build-standalone interpreter spawns child
        processes (extension setup.py, runner.py). Without this they're
        denied by Hardened Runtime under cs.disable-library-validation
        alone.
    -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!--
        Network access is required for HuggingFace model downloads.
    -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!--
        Read/write access to user-selected paths (workspace, models)
        outside the sandbox container. We do not enable App Sandbox;
        these are kept for forward compatibility if it's added later.
    -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
